# {{ansible_managed}}
{% set config = redis_server.systemd %}
[Unit]
Description=Redis persistent key-value database
After=network.target

[Service]
ExecStart=/usr/bin/redis-server {{redis_server['config_file']}} --supervised systemd
ExecStop=kill {{redis_server['pid_file'] }}
Type=notify
User=redis
Group=redis
RuntimeDirectory=redis
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target

